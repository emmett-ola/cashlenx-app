# CashLenX app environment example
# Copy to .env for local use. ENV_FILE may select another repository-local file
# when running scripts/build.sh, scripts/start.sh, or scripts/stop.sh.

# Application and API settings used by Flutter.
# APP_ENV accepts dev, staging, or prod; unknown values fall back to dev.
APP_ENV=dev
# API_SCHEME is the URL scheme only: http or https, without ://.
API_SCHEME=http
# API_DOMAIN is a hostname or IP address without scheme, port, or path.
API_DOMAIN=127.0.0.1
# API_PORT is an integer from 1 to 65535. Leave it empty to omit an explicit
# port when the API uses the scheme's default port.
API_PORT=10063
# API_VERSION is the URL path appended after the host, without a leading slash.
API_VERSION=api/v0

# Docker settings. Every value is active and may be changed directly.
# Explicit Compose project and shared external-network names. Keep the network
# value identical in the App, Server, and Website environment files. Compose
# project names start with a lowercase letter/digit and use lowercase letters,
# digits, hyphens, or underscores. Network/container names start alphanumeric
# and may additionally use periods. Do not set reserved COMPOSE_PROJECT_NAME;
# it overrides APP_PROJECT_NAME.
APP_PROJECT_NAME=cashlenx-app
DOCKER_NETWORK_NAME=cashlenx-network
# WEB_PORT is the published host port. WEB_BIND_ADDRESS controls which host
# interface accepts connections; keep 127.0.0.1 when using a local reverse proxy.
WEB_PORT=10064
WEB_BIND_ADDRESS=127.0.0.1
# IMAGE_NAME is a Docker repository name and IMAGE_TAG is its tag. Container and
# build-image values must use names understood by the local Docker daemon.
IMAGE_NAME=cashlenx-app
IMAGE_TAG=latest
CONTAINER_NAME=cashlenx-app
FLUTTER_BUILD_IMAGE=ghcr.io/cirruslabs/flutter:stable
NGINX_IMAGE=nginx:alpine

# Container resource and health settings.
# CPU values are decimal CPU cores, memory values use Docker units such as 256m
# or 1g, PID/retry values are positive integers, and time values use Compose
# durations such as 5s, 1m, or 1m30s.
WEB_CPU_LIMIT=1.0
WEB_CPU_RESERVATION=0.25
WEB_MEMORY_LIMIT=1g
WEB_MEMORY_RESERVATION=256m
WEB_PIDS_LIMIT=256
WEB_STOP_GRACE_PERIOD=15s
WEB_HEALTHCHECK_INTERVAL=15s
WEB_HEALTHCHECK_TIMEOUT=5s
WEB_HEALTHCHECK_RETRIES=3
WEB_HEALTHCHECK_START_PERIOD=15s
