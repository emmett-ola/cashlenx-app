# The environment format (e.g. dev, staging, prod)
APP_ENV=dev

# Server Protocol (e.g., http, https)
API_SCHEME=http

# App API domain logic
API_DOMAIN=localhost

# API server port
API_PORT=11063

# API versioning path
API_VERSION=api/v0

# Docker Config
WEB_PORT=11064
WEB_BIND_ADDRESS=127.0.0.1
IMAGE_NAME=cashlenx-web
IMAGE_TAG=latest
CONTAINER_NAME=cashlenx-app
FLUTTER_BUILD_IMAGE=ghcr.io/cirruslabs/flutter:stable
NGINX_IMAGE=nginx:alpine
WEB_CPU_LIMIT=1.0
WEB_CPU_RESERVATION=0.25
WEB_MEMORY_LIMIT=1g
WEB_MEMORY_RESERVATION=256m
WEB_PIDS_LIMIT=256
WEB_STOP_GRACE_PERIOD=15s
WEB_HEALTHCHECK_INTERVAL=15s
WEB_HEALTHCHECK_TIMEOUT=5s
WEB_HEALTHCHECK_RETRIES=3
WEB_HEALTHCHECK_START_PERIOD=15s
